numSets = 3

thetas_all = cell(numSets,1);
weights_all = cell(numSets,1);
hdi95_all = cell(numSets,1);
theta_vars_all = cell(numSets,1);
for c=1:numSets
    thetas_all{c} = [];
    weights_all{c} = [];
end

% data
S = load('learnedRealData.mat');
for c=1:length(S.results)
    thetas_all{1}(end+1,:,:) = S.results(c).theta;
    weights_all{1}(end+1,:,:) = S.results(c).weights;
end

% neg ctrls
S = load('learnedNegCtrl.mat');
for c=1:length(S.results)
    thetas_all{2}(end+1,:,:) = S.results(c).theta;
    weights_all{2}(end+1,:,:) = S.results(c).weights;
end

% downsampled
S = load('learnedDownsampled.mat');
for c=1:length(S.results)
    thetas_all{3}(end+1,:,:) = S.results(c).theta;
    weights_all{3}(end+1,:,:) = S.results(c).weights;
end

load('learned_lims.mat'); % learned_limits - limits of priors for learned params

%% combine all into N*numReps x D matrices
thetas_all_linear = cell(numSets,1);
weights_all_linear = cell(numSets,1);
D = size(thetas_all{1},3);
map_particles = zeros(numSets,D);
map_particles_per_rep = cell(numSets,1);
for c=1:numSets
    [numReps, N, D] = size(thetas_all{c});
    thetas_all_linear{c} = reshape(thetas_all{c},numReps*N,D);
    weights_all_linear{c} = reshape(weights_all{c},numReps*N,1);
    w = weights_all_linear{c} / sum(weights_all_linear{c});
    map_particles(c,:) = sum(w .* thetas_all_linear{c}, 1); % weighted mean of particles
    map_particles_per_rep{c} = zeros(numReps,D);
    for i=1:numReps
        w = weights_all{c}(i,:) / sum(weights_all{c}(i,:));
        map_particles_per_rep{c}(i,:) = sum(w.* thetas_all{c}(i,:,:), 2);
    end
end

%% analyse
diffs = distributionOfDifferences(reshape(thetas_all{1}(:,:,14),[],1),weights_all{1}(:),...
    reshape(thetas_all{2}(:,:,14),[],1),weights_all{2}(:),100000);
disp('The real data is higher than the neg ctrl in ___ of pairs:')
sum(nnz(diffs>0))/length(diffs)

